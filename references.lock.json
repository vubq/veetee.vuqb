{
  "schema_version": 1,
  "purpose": "Pinned read-only reference snapshots used by docs/00-reference-analysis.md and protocol compatibility work.",
  "policy": {
    "tracked_in_main_repository": true,
    "reference_worktrees_are_ignored": true,
    "never_vendor_or_modify_reference_source": true,
    "update_flow": [
      "git -C references/<snapshot> fetch origin --prune",
      "git -C references/<snapshot> log --oneline --decorate <locked_commit>..origin/main",
      "git -C references/<snapshot> diff --stat <locked_commit>..origin/main",
      "git -C references/<snapshot> diff <locked_commit>..origin/main -- <path>",
      "After review, update this lock file and docs/00-reference-analysis.md together."
    ]
  },
