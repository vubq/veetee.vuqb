{
  "name": "veetee-manager-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/migrate.ts",
    "openapi:export": "tsx src/openapi-export.ts",
    "openapi:check": "tsx src/openapi-check.ts",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/sensible": "6.0.3",
    "@fastify/swagger": "9.8.1",
    "@sinclair/typebox": "0.34.41",
    "argon2": "0.45.1",
    "drizzle-orm": "^0.45.2",
    "env-schema": "7.0.0",
    "fastify": "5.11.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
