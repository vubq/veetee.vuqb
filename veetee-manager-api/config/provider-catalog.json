{
  "schemaVersion": 1,
  "installations": [
    {
      "id": "veetee.vad.energy",
      "kind": "vad",
      "displayNameKey": "provider.vad.energy",
      "version": "1.0.0",
      "manifest": { "locales": ["*"], "supportsCancel": true },
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speechThreshold", "releaseThreshold", "minSpeechMs", "minSilenceMs"],
        "properties": {
          "speechThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "releaseThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "minSpeechMs": { "type": "integer", "minimum": 1 },
          "minSilenceMs": { "type": "integer", "minimum": 1 }
        }
      }
    },
    {
      "id": "veetee.vad.silero",
      "kind": "vad",
      "displayNameKey": "provider.vad.silero",
      "version": "1.0.0",
      "manifest": { "locales": ["*"], "supportsStreaming": true, "supportsCancel": true, "requiresLocalArtifact": true },
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modelPath", "speechThreshold", "releaseThreshold", "minSpeechMs", "minSilenceMs"],
        "properties": {
          "modelPath": { "type": "string", "minLength": 1 },
          "sampleRate": { "type": "integer", "enum": [16000] },
          "windowSamples": { "type": "integer", "minimum": 128, "maximum": 4096 },
          "speechThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "releaseThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "minSpeechMs": { "type": "integer", "minimum": 1 },
          "minSilenceMs": { "type": "integer", "minimum": 1 }
        }
      }
    },
    {
      "id": "veetee.asr.fixture",
      "kind": "asr",
      "displayNameKey": "provider.asr.fixture",
      "version": "1.0.0",
      "manifest": { "locales": ["*"], "supportsPartial": false, "supportsCancel": true },
      "configSchema": { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string", "minLength": 1 } } }
    },
    {
      "id": "veetee.asr.phowhisper",
      "kind": "asr",
      "displayNameKey": "provider.asr.phowhisper",
      "version": "1.0.0",
      "manifest": { "locales": ["vi-VN", "vi"], "supportsPartial": false, "supportsCancel": true, "requiresLocalArtifact": true },
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modelPath"],
        "properties": {
          "modelPath": { "type": "string", "minLength": 1 },
          "device": { "type": "string", "enum": ["cuda", "cpu"] },
          "computeType": { "type": "string", "enum": ["float16", "int8_float16", "int8" ] },
          "cpuThreads": { "type": "integer", "minimum": 1, "maximum": 32 },
          "numWorkers": { "type": "integer", "minimum": 1, "maximum": 4 },
          "sampleRate": { "type": "integer", "minimum": 1, "maximum": 48000 },
          "beamSize": { "type": "integer", "minimum": 1, "maximum": 5 },
          "conditionOnPreviousText": { "type": "boolean" },
          "withoutTimestamps": { "type": "boolean" },
          "vadFilter": { "type": "boolean" }
        }
      }
    },
    {
      "id": "groq.chat",
      "kind": "llm",
      "displayNameKey": "provider.llm.groq",
      "version": "1.0.0",
      "manifest": { "locales": ["*"], "supportsStreaming": true, "supportsTools": true, "secretFields": ["apiKey"] },
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpoint", "model", "maxTokens"],
        "properties": {
          "endpoint": { "type": "string", "format": "uri" },
          "model": { "type": "string", "minLength": 1 },
          "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
          "maxTokens": { "type": "integer", "minimum": 1, "maximum": 32768 }
        }
      }
    },
    {
      "id": "veetee.llm.fixture",
      "kind": "llm",
      "displayNameKey": "provider.llm.fixture",
      "version": "1.0.0",
      "manifest": { "locales": ["*"], "supportsStreaming": true, "supportsTools": false },
      "configSchema": { "type": "object", "additionalProperties": false, "required": ["segments"], "properties": { "segments": { "type": "array", "items": { "type": "string" }, "minItems": 1 } } }
    },
    {
      "id": "vieneu.v3-turbo",
      "kind": "tts",
      "displayNameKey": "provider.tts.vieneu",
      "version": "1.0.0",
      "manifest": { "locales": ["vi-VN"], "supportsStreaming": true, "supportsCancel": true },
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backboneRepo", "sampleRate"],
        "properties": {
          "backboneRepo": { "type": "string", "minLength": 1 },
          "modelPath": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["v3turbo"] },
          "backend": { "type": "string", "enum": ["onnx", "auto"] },
          "precision": { "type": "string", "enum": ["int8", "fp32"] },
          "prewarm": { "type": "boolean" },
          "sampleRate": { "type": "integer", "minimum": 1, "maximum": 48000 },
          "sourceSampleRate": { "type": "integer", "minimum": 1, "maximum": 48000 },
          "threads": { "type": "integer", "minimum": 0, "maximum": 32 },
          "modelSubfolder": { "type": "string", "minLength": 1 },
          "mossTokenizer": { "type": "string", "minLength": 1 },
          "onnxRepo": { "type": "string", "minLength": 1 },
          "onnxDir": { "type": "string", "minLength": 1 },
          "codecRepo": { "type": "string", "minLength": 1 },
          "codecDir": { "type": "string", "minLength": 1 },
          "onnxSubfolder": { "type": "string", "minLength": 1 },
          "maxBatchSize": { "type": "integer", "minimum": 1, "maximum": 128 }
        }
      }
    },
    {
      "id": "veetee.tts.fixture-tone",
      "kind": "tts",
      "displayNameKey": "provider.tts.fixture",
      "version": "1.0.0",
      "manifest": { "locales": ["*"], "supportsStreaming": true, "supportsCancel": true },
      "configSchema": { "type": "object", "additionalProperties": false, "required": ["sampleRate", "toneHz", "chunkMs", "amplitude"], "properties": { "sampleRate": { "type": "integer", "minimum": 1 }, "toneHz": { "type": "number", "minimum": 1 }, "chunkMs": { "type": "integer", "minimum": 1 }, "amplitude": { "type": "number", "minimum": 0, "maximum": 1 } } }
    },
    {
      "id": "veetee.intent.patterns",
      "kind": "intent",
      "displayNameKey": "provider.intent.patterns",
      "version": "1.0.0",
      "manifest": { "locales": ["*"], "supportsCancel": true },
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rules"],
        "properties": {
          "rules": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "object" } }
        }
      }
    },
    {
      "id": "veetee.memory.session-window",
      "kind": "memory",
      "displayNameKey": "provider.memory.sessionWindow",
      "version": "1.0.0",
      "manifest": { "locales": ["*"], "supportsCancel": true },
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["maxTurns", "maxCharacters"],
        "properties": {
          "maxTurns": { "type": "integer", "minimum": 1, "maximum": 64 },
          "maxCharacters": { "type": "integer", "minimum": 256, "maximum": 100000 }
        }
      }
    }
  ]
}
