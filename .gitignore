# Dependencies and generated build/test output
**/node_modules/
**/dist/
**/build/
**/.vite/
**/coverage/
**/test-results/
**/playwright-report/
**/*.tsbuildinfo

# Local environment and secrets
.env
.env.*
!.env.example
*.local
*.log
*.pem
*.key
*.p12

# Test-only credential lists. Keep the tracked shape in secrets/*.example.
secrets/*.keys
secrets/*.secret

# Host-local agent/tool state and visual artifacts
.agents/
.claude/
.playwright-cli/
.superpowers/
output/

# Read-only architecture reference snapshots; not product source
references/

# OS/editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
