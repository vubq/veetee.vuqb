# Dependencies and generated build/test output
**/node_modules/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/dist/
**/build/
**/.vite/
**/coverage/
**/test-results/
**/playwright-report/
**/*.tsbuildinfo
**/build*/
/veetee-firmware/sdkconfig
/veetee-firmware/managed_components/

# Local environment and secrets
.env
.env.*
!.env.example
*.local
*.log
*.pem
*.key
*.p12

# Test-only credential lists. Keep the tracked shape in secrets/*.example.
secrets/*.keys
secrets/*.secret
secrets/*.url
secrets/*.database-url
secrets/*.token
secrets/*.machine-token

# Host-local agent/tool state and visual artifacts
.agents/
.claude/
.playwright-cli/
.superpowers/
output/
.runtime/

# Read-only architecture reference snapshots; not product source
references/

# OS/editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
