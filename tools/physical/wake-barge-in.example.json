{
  "monitor": {
    "command": ["idf.py"],
    "projectDir": "../../veetee-firmware",
    "serialPort": "/dev/ttyACM0",
    "baud": 115200,
    "healthUrl": "http://127.0.0.1:18100/health/ready",
    "startupWaitSeconds": 1
  },
  "player": {"command": ["pw-play", "{file}"]},
  "clips": {
    "wake": "./local-wake-computer.wav",
    "utterance": "./local-utterance-vi.wav"
  },
  "firmware": {
    "configFile": "../../veetee-firmware/sdkconfig",
    "requiredProtocolProfile": 3,
    "requireWakeEnabled": true
  },
  "repetitions": 1,
  "interRepetitionDelaySeconds": 0.75,
  "utteranceAfter": "capture_started",
  "events": [
    {"name": "wake_detected", "marker": "wake detected", "timeoutSeconds": 15},
    {"name": "capture_started", "marker": "wake start", "timeoutSeconds": 8},
    {"name": "assistant_speaking", "marker": "state=speaking", "timeoutSeconds": 45}
  ],
  "bargeIn": {
    "clip": "./local-wake-computer.wav",
    "afterStage": "assistant_speaking",
    "events": [
      {"name": "interrupt_wake_detected", "marker": "wake detected", "timeoutSeconds": 15},
      {"name": "interrupt_state_listening", "marker": "state=listening", "timeoutSeconds": 8},
      {"name": "interrupt_abort_committed", "marker": "wake interrupt", "timeoutSeconds": 8},
      {"name": "interrupt_listen_started", "marker": "wake start", "timeoutSeconds": 8}
    ]
  },
  "forbiddenMarkers": ["panic", "stack overflow", "abort() was called", "Opus playback decode failed"]
}
