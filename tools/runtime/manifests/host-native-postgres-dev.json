{
  "schemaVersion": 1,
  "services": [
    {
      "name": "veetee-machine-token",
      "command": ["${PYTHON}", "tools/runtime/ensure_secret.py", "--path", "${VEETEE_ROOT}/secrets/manager.machine-token"],
      "cwd": "${VEETEE_ROOT}",
      "waitForExit": true,
      "readyTimeoutSeconds": 10,
      "dependencies": []
    },
    {
      "name": "veetee-postgres",
      "command": ["${PYTHON}", "tools/runtime/postgres_instance.py"],
      "cwd": "${VEETEE_ROOT}",
      "environment": {
        "VEETEE_POSTGRES_BIN_DIR": "${VEETEE_ROOT}/.runtime/postgres-tools/usr/lib/postgresql/16/bin",
        "VEETEE_POSTGRES_LIB_DIR": "${VEETEE_ROOT}/.runtime/postgres-tools/usr/lib/x86_64-linux-gnu",
        "VEETEE_POSTGRES_DATA_DIR": "${VEETEE_ROOT}/.runtime/veetee-postgres-data",
        "VEETEE_POSTGRES_SOCKET_DIR": "${VEETEE_ROOT}/.runtime/veetee-postgres-socket",
        "VEETEE_POSTGRES_HOST": "127.0.0.1",
        "VEETEE_POSTGRES_PORT": "55432",
        "VEETEE_POSTGRES_USER": "veetee",
        "VEETEE_POSTGRES_DATABASE": "veetee_vubq"
      },
      "healthTcp": {"host": "127.0.0.1", "port": 55432},
      "readyTimeoutSeconds": 30,
      "dependencies": []
    },
    {
      "name": "veetee-manager-db-migrate",
      "command": ["npm", "run", "db:migrate"],
      "cwd": "${VEETEE_ROOT}/veetee-manager-api",
      "environment": {
        "VEETEE_DATABASE_URL_FILE": "${VEETEE_ROOT}/secrets/manager.database-url"
      },
      "readyTimeoutSeconds": 30,
      "waitForExit": true,
      "dependencies": ["veetee-postgres", "veetee-machine-token"]
    },
    {
      "name": "veetee-manager-api-postgres",
      "command": ["npm", "run", "dev"],
      "cwd": "${VEETEE_ROOT}/veetee-manager-api",
      "environment": {
        "VEETEE_API_HOST": "127.0.0.1",
        "VEETEE_API_PORT": "18101",
        "VEETEE_DATABASE_MODE": "postgres",
        "VEETEE_DATABASE_URL_FILE": "${VEETEE_ROOT}/secrets/manager.database-url",
        "VEETEE_MACHINE_TOKEN_FILE": "${VEETEE_ROOT}/secrets/manager.machine-token",
        "VEETEE_SECRET_STORE_FILE": "${VEETEE_ROOT}/.runtime/manager-secrets.json",
        "VEETEE_SECRET_MASTER_KEY_FILE": "${VEETEE_ROOT}/secrets/manager.secret",
        "VEETEE_INITIAL_SNAPSHOT_FILE": "${VEETEE_ROOT}/veetee-server/config/fixtures/m0.json",
        "VEETEE_PROVIDER_CATALOG_FILE": "${VEETEE_ROOT}/veetee-manager-api/config/provider-catalog.json",
        "VEETEE_ALLOWED_ORIGINS": "http://127.0.0.1:18181",
        "VEETEE_AUTH_MODE": "disabled",
        "VEETEE_LOG_LEVEL": "info"
      },
      "healthUrl": "http://127.0.0.1:18101/health/ready",
      "readyTimeoutSeconds": 30,
      "dependencies": ["veetee-manager-db-migrate"]
    },
    {
      "name": "veetee-server-postgres",
      "command": ["${VEETEE_ROOT}/veetee-server/.venv/bin/python", "-m", "veetee_server"],
      "cwd": "${VEETEE_ROOT}/veetee-server",
      "environment": {
        "VEETEE_CONFIG_SOURCE": "manager",
        "VEETEE_MANAGER_API_URL": "http://127.0.0.1:18101",
        "VEETEE_MACHINE_TOKEN_FILE": "${VEETEE_ROOT}/secrets/manager.machine-token",
        "VEETEE_HISTORY_ENABLED": "true",
        "VEETEE_PRESENCE_ENABLED": "true",
        "VEETEE_VOICE_HOST": "0.0.0.0",
        "VEETEE_VOICE_PORT": "18100",
        "VEETEE_GROQ_SECRET_FILE": "${VEETEE_ROOT}/secrets/groq.keys",
        "VEETEE_SECRET_STORE_FILE": "${VEETEE_ROOT}/.runtime/manager-secrets.json",
        "VEETEE_SECRET_MASTER_KEY_FILE": "${VEETEE_ROOT}/secrets/manager.secret"
      },
      "healthUrl": "http://127.0.0.1:18100/health/ready",
      "readyTimeoutSeconds": 30,
      "dependencies": ["veetee-manager-api-postgres"]
    },
    {
      "name": "manager-web-postgres",
      "command": ["npm", "run", "dev", "--", "--host", "127.0.0.1", "--port", "18181"],
      "cwd": "${VEETEE_ROOT}/veetee-manager-web",
      "environment": {
        "VITE_MANAGER_API_URL": "/",
        "VEETEE_WEB_API_PROXY_TARGET": "http://127.0.0.1:18101",
        "VEETEE_WEB_VOICE_PROXY_TARGET": "http://127.0.0.1:18100"
      },
      "healthUrl": "http://127.0.0.1:18181/",
      "readyTimeoutSeconds": 30,
      "dependencies": ["veetee-manager-api-postgres"]
    }
  ]
}
