menu "Veetee firmware"

config VEETEE_BOARD_PROFILE
    string "Verified board profile identifier"
    default ""
    help
        Identifier resolved from the operator-supplied board manifest. An empty
        value keeps the firmware in bring-up mode and must not be flashed to a
        physical board.

config VEETEE_PROTOCOL_PROFILE
    int "WebSocket protocol profile"
    range 1 3
    default 3
    help
        3 is the product default. 1 and 2 are explicit compatibility profiles.

config VEETEE_WS_URI
    string "Veetee WebSocket URI"
    default ""
    help
        Runtime endpoint. Keep empty until an operator provisions a LAN/TLS
        endpoint; the firmware must not invent a host address.

config VEETEE_WIFI_SSID
    string "Optional station SSID for first provisioning"
    default ""
    help
        Used only when the NVS station profile has no SSID. Keep empty to
        preserve the existing NVS profile and never log this value.

config VEETEE_WIFI_PASSWORD
    string "Optional station password for first provisioning"
    default ""
    help
        Used only with VEETEE_WIFI_SSID when the NVS profile is empty. This is
        a local build input and must not be committed or printed in logs.

config VEETEE_WIFI_OVERRIDE_NVS
    bool "Override saved NVS station profile"
    default n
    help
        Use only for an explicit local provisioning test. When disabled, a
        non-empty NVS SSID always wins over build-time values.

config VEETEE_ENABLE_HARDWARE
    bool "Enable verified board audio and PTT hardware"
    default n
    help
        Enable only after the board profile has been verified. Host builds do
        not use this option.

config VEETEE_WAKE_ENABLED
    bool "Enable on-device wake word"
    default n
    depends on VEETEE_ENABLE_HARDWARE
    help
        Keep microphone processing local while the device is idle. The selected
        model is packed into the model partition by ESP-SR. If initialization
        fails at boot, PTT remains available.

choice VEETEE_WAKE_MODEL
    prompt "Wake word model"
    default VEETEE_WAKE_MODEL_COMPUTER_TTS
    depends on VEETEE_WAKE_ENABLED

config VEETEE_WAKE_MODEL_COMPUTER_TTS
    bool "Computer (ESP-SR English test preset)"

config VEETEE_WAKE_MODEL_HIESP
    bool "Hi,ESP (ESP-SR preset)"

endchoice

config VEETEE_WAKE_MODEL_NAME
    string "Wake word model identifier"
    default "wn9_computer_tts" if VEETEE_WAKE_MODEL_COMPUTER_TTS
    default "wn9_hiesp" if VEETEE_WAKE_MODEL_HIESP
    depends on VEETEE_WAKE_ENABLED
    help
        The exact ESP-SR model identifier. Keep this in the config/asset
        manifest; conversation code must not contain a wake phrase literal.

config VEETEE_WAKE_MODEL_PARTITION
    string "Wake model partition label"
    default "model"
    depends on VEETEE_WAKE_ENABLED

config VEETEE_WAKE_DETECTION_MODE
    int "WakeNet detection mode (90 or 95)"
    range 90 95
    default 90
    depends on VEETEE_WAKE_ENABLED

config VEETEE_WAKE_THRESHOLD_PERCENT
    int "WakeNet threshold percent"
    range 40 99
    default 65
    depends on VEETEE_WAKE_ENABLED
    help
        The default matches the selected Computer model manifest's calibrated
        0.648-0.650 threshold. Tune per signed model asset; do not use a
        generic high threshold that makes the configured phrase unreachable.

config VEETEE_WAKE_INPUT_BUFFER_SAMPLES
    int "Wake input buffer samples"
    range 1024 16384
    default 4096
    depends on VEETEE_WAKE_ENABLED

config VEETEE_PTT_GPIO
    int "Push-to-talk GPIO"
    default -1

config VEETEE_PTT_ACTIVE_LEVEL
    int "Push-to-talk active level"
    range 0 1
    default 0

config VEETEE_MIC_BCLK_GPIO
    int "Microphone I2S BCLK GPIO"
    default -1

config VEETEE_MIC_WS_GPIO
    int "Microphone I2S WS GPIO"
    default -1

config VEETEE_MIC_DIN_GPIO
    int "Microphone I2S DIN GPIO"
    default -1

config VEETEE_SPK_BCLK_GPIO
    int "Speaker I2S BCLK GPIO"
    default -1

config VEETEE_SPK_WS_GPIO
    int "Speaker I2S WS GPIO"
    default -1

config VEETEE_SPK_DOUT_GPIO
    int "Speaker I2S DOUT GPIO"
    default -1

config VEETEE_MIC_SAMPLE_RATE
    int "Microphone sample rate"
    range 8000 48000
    default 16000

config VEETEE_SPK_SAMPLE_RATE
    int "Speaker sample rate"
    range 8000 48000
    default 24000

config VEETEE_AUDIO_FRAME_DURATION_MS
    int "Opus frame duration"
    range 20 120
    default 60

config VEETEE_NOISE_SUPPRESSION_ENABLED
    bool "Enable on-device noise suppression"
    default n
    depends on VEETEE_ENABLE_HARDWARE
    help
        Run the ESP-SR single-microphone noise suppressor before WakeNet and
        uplink encoding. The current board is simplex I2S, so this option does
        not provide acoustic echo cancellation; AEC requires a verified
        playback-reference channel and remains a separate promotion gate.

config VEETEE_NOISE_SUPPRESSION_MODE
    int "Noise suppression strength"
    range 0 2
    default 1
    depends on VEETEE_NOISE_SUPPRESSION_ENABLED
    help
        ESP-SR mode: 0 mild, 1 medium, 2 aggressive. Keep this in the board
        configuration so model/strength changes do not require source edits.

config VEETEE_PLAYBACK_QUEUE_DEPTH
    int "Downlink Opus playback queue depth"
    range 4 64
    default 32
    help
        Number of encoded downlink frames buffered while the I2S decoder
        catches up with a streaming TTS burst. Increase only when PSRAM and
        internal heap headroom have been measured on the target board.

config VEETEE_AUDIO_DIAGNOSTICS
    bool "Log bounded microphone level diagnostics"
    default n
    depends on VEETEE_ENABLE_HARDWARE
    help
        Log rate-limited sample count, peak and mean absolute level only. No
        PCM, transcript or microphone content is logged. Enable temporarily
        for physical audio bring-up; keep disabled in normal builds.

config VEETEE_LCD_ENABLED
    bool "Enable ST7789 LCD"
    default n

config VEETEE_LCD_SPI_HOST
    int "LCD SPI host"
    range 1 2
    default 2

config VEETEE_LCD_WIDTH
    int "LCD width"
    range 1 1024
    default 240

config VEETEE_LCD_HEIGHT
    int "LCD height"
    range 1 1024
    default 280

config VEETEE_LCD_OFFSET_X
    int "LCD offset X"
    range 0 1024
    default 0

config VEETEE_LCD_OFFSET_Y
    int "LCD offset Y"
    range 0 1024
    default 20

config VEETEE_LCD_MOSI_GPIO
    int "LCD MOSI GPIO"
    range 0 48
    default 47

config VEETEE_LCD_SCLK_GPIO
    int "LCD SCLK GPIO"
    range 0 48
    default 21

config VEETEE_LCD_DC_GPIO
    int "LCD DC GPIO"
    range 0 48
    default 40

config VEETEE_LCD_RESET_GPIO
    int "LCD reset GPIO"
    range 0 48
    default 45

config VEETEE_LCD_CS_GPIO
    int "LCD CS GPIO"
    range 0 48
    default 41

config VEETEE_LCD_BACKLIGHT_GPIO
    int "LCD backlight GPIO"
    range 0 48
    default 42

config VEETEE_LCD_BACKLIGHT_ACTIVE_LEVEL
    int "LCD backlight active level"
    range 0 1
    default 1

config VEETEE_LCD_SPI_MODE
    int "LCD SPI mode"
    range 0 3
    default 0

config VEETEE_LCD_INVERT_COLOR
    bool "Invert LCD colors"
    default y

config VEETEE_LCD_RGB_ORDER_BGR
    bool "Use BGR LCD color order"
    default n

config VEETEE_LCD_MIRROR_X
    bool "Mirror LCD X"
    default n

config VEETEE_LCD_MIRROR_Y
    bool "Mirror LCD Y"
    default n

config VEETEE_LCD_SWAP_XY
    bool "Swap LCD axes"
    default n

config VEETEE_BOOT_CHIME_ENABLED
    bool "Play startup chime"
    default n

config VEETEE_BOOT_CHIME_FIRST_HZ
    int "Startup chime first frequency"
    range 100 4000
    default 880

config VEETEE_BOOT_CHIME_SECOND_HZ
    int "Startup chime second frequency"
    range 100 4000
    default 1175

config VEETEE_BOOT_CHIME_TONE_MS
    int "Startup chime tone duration"
    range 20 500
    default 90

config VEETEE_BOOT_CHIME_GAP_MS
    int "Startup chime gap"
    range 0 500
    default 35

config VEETEE_BOOT_CHIME_AMPLITUDE
    int "Startup chime amplitude"
    range 100 30000
    default 9000

endmenu
