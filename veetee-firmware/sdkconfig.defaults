CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# ESP32-S3 N16R8 board profile: keep Octal PSRAM available for audio/model
# allocations even when the optional WakeNet feature is disabled.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_MEMTEST=n
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_VEETEE_BOARD_PROFILE="bread-compact-wifi-lcd"
CONFIG_VEETEE_PROTOCOL_PROFILE=3
CONFIG_VEETEE_WS_TASK_STACK=4096
CONFIG_VEETEE_WS_BUFFER_SIZE=4096
CONFIG_VEETEE_AP_SSID_PREFIX="Veetee"
CONFIG_VEETEE_AP_CHANNEL=6
CONFIG_VEETEE_ENABLE_HARDWARE=y
CONFIG_VEETEE_WAKE_ENABLED=y
CONFIG_VEETEE_WAKE_MODEL_COMPUTER_TTS=y
CONFIG_VEETEE_WAKE_MODEL_NAME="wn9_computer_tts"
CONFIG_VEETEE_WAKE_MODEL_PARTITION="model"
CONFIG_VEETEE_WAKE_DETECTION_MODE=90
CONFIG_VEETEE_WAKE_THRESHOLD_PERCENT=65
CONFIG_VEETEE_WAKE_INPUT_BUFFER_SAMPLES=4096
CONFIG_VEETEE_AEC_ENABLED=y
CONFIG_VEETEE_AEC_FILTER_LENGTH=4
CONFIG_VEETEE_AEC_REFERENCE_BUFFER_MS=500
CONFIG_VEETEE_AEC_REFERENCE_DELAY_MS=80
CONFIG_VEETEE_WAKE_DURING_PLAYBACK=y
CONFIG_VEETEE_AEC_PROCESS_WAKE=y
# Keep WebSocket RX/control and TX paths on separate ESP-IDF locks. This avoids
# duplex audio frames waiting behind a receive-side callback or keepalive.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_VEETEE_PTT_GPIO=0
CONFIG_VEETEE_PTT_ACTIVE_LEVEL=0
CONFIG_VEETEE_MIC_BCLK_GPIO=5
CONFIG_VEETEE_MIC_WS_GPIO=4
CONFIG_VEETEE_MIC_DIN_GPIO=6
CONFIG_VEETEE_SPK_BCLK_GPIO=15
CONFIG_VEETEE_SPK_WS_GPIO=16
CONFIG_VEETEE_SPK_DOUT_GPIO=7
CONFIG_VEETEE_MIC_SAMPLE_RATE=16000
CONFIG_VEETEE_SPK_SAMPLE_RATE=24000
CONFIG_VEETEE_AUDIO_FRAME_DURATION_MS=60
CONFIG_VEETEE_NOISE_SUPPRESSION_ENABLED=y
CONFIG_VEETEE_NOISE_SUPPRESSION_MODE=1
CONFIG_VEETEE_PLAYBACK_QUEUE_DEPTH=32
CONFIG_SR_WN_WN9_COMPUTER_TTS=y
CONFIG_VEETEE_MCP_ENABLED=y
CONFIG_VEETEE_MCP_CAPABILITY_REVISION=1
CONFIG_VEETEE_MCP_QUEUE_DEPTH=2
CONFIG_VEETEE_MCP_TASK_STACK=12288
CONFIG_VEETEE_MCP_TASK_PRIORITY=14
CONFIG_VEETEE_BOARD_STATUS_LED_GPIO=48
CONFIG_VEETEE_BOARD_LAMP_GPIO=18
CONFIG_VEETEE_BOARD_STATUS_LED_ACTIVE_LEVEL=1
CONFIG_VEETEE_BOARD_LAMP_ACTIVE_LEVEL=1
CONFIG_VEETEE_BOARD_STATUS_LED_RGB=y
CONFIG_VEETEE_LCD_ENABLED=y

# LVGL is used as the firmware UI runtime; example/demo applications are not
# shipped in the product image.
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_VEETEE_LCD_SPI_HOST=2
CONFIG_VEETEE_LCD_WIDTH=240
CONFIG_VEETEE_LCD_HEIGHT=280
CONFIG_VEETEE_LCD_OFFSET_X=0
CONFIG_VEETEE_LCD_OFFSET_Y=20
CONFIG_VEETEE_LCD_MOSI_GPIO=47
CONFIG_VEETEE_LCD_SCLK_GPIO=21
CONFIG_VEETEE_LCD_DC_GPIO=40
CONFIG_VEETEE_LCD_RESET_GPIO=45
CONFIG_VEETEE_LCD_CS_GPIO=41
CONFIG_VEETEE_LCD_BACKLIGHT_GPIO=42
CONFIG_VEETEE_LCD_BACKLIGHT_ACTIVE_LEVEL=1
CONFIG_VEETEE_LCD_SPI_MODE=0
CONFIG_VEETEE_LCD_INVERT_COLOR=y
# CONFIG_VEETEE_LCD_RGB_ORDER_BGR is not set
# CONFIG_VEETEE_LCD_MIRROR_X is not set
# CONFIG_VEETEE_LCD_MIRROR_Y is not set
# CONFIG_VEETEE_LCD_SWAP_XY is not set
CONFIG_VEETEE_BOOT_CHIME_ENABLED=y
CONFIG_VEETEE_BOOT_CHIME_FIRST_HZ=880
CONFIG_VEETEE_BOOT_CHIME_SECOND_HZ=1175
CONFIG_VEETEE_BOOT_CHIME_TONE_MS=90
CONFIG_VEETEE_BOOT_CHIME_GAP_MS=35
CONFIG_VEETEE_BOOT_CHIME_AMPLITUDE=9000
