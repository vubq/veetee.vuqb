{
  "name": "veetee-manager-web",
  "version": "0.0.0-preview",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "api:generate": "openapi-typescript ../veetee-manager-api/openapi/manager-api.json -o src/api/generated.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@lucide/vue": "1.28.0",
    "pinia": "4.0.2",
    "reka-ui": "2.10.1",
    "vue": "3.5.40",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.9"
  }
}
